{
  "name": "quatre-jours",
  "version": "0.1.0",
  "private": true,
  "description": "Site d'offres d'emploi en semaine de 4 jours",
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "import": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import.js",
    "digest": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/digest.js",
    "seed:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed-dev.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "5.1.0",
    "nodemailer": "6.10.0"
  }
}
