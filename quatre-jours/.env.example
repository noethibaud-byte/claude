# Copier ce fichier en .env et le remplir. Ne jamais publier le fichier .env.

NODE_ENV=production
PORT=3000
BASE_URL=https://quatre-jours.fr
DATABASE_PATH=data/quatre-jours.db

# Longue chaîne aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
# Mot de passe de la page /admin (identifiant : n'importe lequel)
ADMIN_PASSWORD=
# Reçoit une alerte à chaque offre payée
ADMIN_EMAIL=

# Prix en centimes
PRICE_CENTS=9900
FEATURED_PRICE_CENTS=4900
JOB_DURATION_DAYS=30
# true = les offres payées sont publiées sans relecture
AUTO_PUBLISH_PAID=false

# Stripe : dashboard.stripe.com > Développeurs > Clés API, puis Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Envoi d'emails, ex. Brevo : smtps://IDENTIFIANT:CLE@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM="Quatre Jours <bonjour@quatre-jours.fr>"

# API France Travail « Offres d'emploi v2 » : francetravail.io
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Mentions légales
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_SIRET=
LEGAL_EMAIL=
HOST_NAME=
HOST_ADDRESS=
